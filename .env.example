# PHP reads these from its process or Apache environment; it does not load .env files.
# Required: set APP_ENV in Apache or the PHP process. Use development for local XAMPP.
APP_ENV=development
# These values show the default XAMPP connection. Set DB_PASS in your environment if needed.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tacloban_praise_db
DB_USER=root
DB_PASS=

# Optional: absolute private storage path outside Apache's document root.
# PRIVATE_UPLOAD_DIR=
# Optional: exact origins allowed to call the PHP API across origins.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional Vite development proxy overrides.
# PHP_API_PROXY_TARGET=http://localhost
# PHP_API_PROXY_BASE_PATH=tacloban-praise
