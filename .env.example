# Vercel: connect TiDB Cloud using Cluster > General. The backend accepts
# TIDB_HOST, TIDB_PORT, TIDB_DATABASE, TIDB_USER, and TIDB_PASSWORD directly.
# Dockerfile.vercel configures database-backed sessions/files and verified TLS.
# Optional build flag for chunked uploads (already set in the Docker build):
# VITE_CLOUD_UPLOADS=1
# Optional PHP settings for database storage outside the container:
# FILE_STORAGE=database
# SESSION_STORAGE=database
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# PHP reads settings from its process environment; it does not load .env files.
# Set APP_ENV in Apache or PHP. Dockerfile.vercel sets production automatically.
APP_ENV=development
# These values show the default XAMPP connection. Set DB_PASS in your environment if needed.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tacloban_praise_db
DB_USER=root
DB_PASS=

# Optional: absolute private storage path outside Apache's document root.
# PRIVATE_UPLOAD_DIR=
# Optional: exact origins allowed to call the PHP API across origins.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional Vite development proxy overrides.
# PHP_API_PROXY_TARGET=http://localhost
# PHP_API_PROXY_BASE_PATH=tacloban-praise
