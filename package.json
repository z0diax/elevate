{
  "name": "hrmdo-praise-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'),path=require('path');const root=path.resolve(process.cwd()),target=path.join(root,'dist');if(path.dirname(target)!==root)throw Error('Invalid build path');fs.rmSync(target,{recursive:true,force:true});\"",
    "lint": "tsc --noEmit",
    "test:unit": "php tests/api_validation.php && php tests/export_security.php && php tests/schema_management.php && php tests/legacy_assignment_backfill.php && php tests/evaluator_access.php && node --import tsx --test tests/evaluator_assignments.test.ts tests/api_client.test.ts",
    "test:integration": "node tests/integration.mjs && php tests/evaluator_reassignment.php"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
